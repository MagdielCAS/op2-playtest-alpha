<div class="op2-card op2-card--survival">
	<header class="op2-card__head">
		<span class="op2-card__title">{{title}}</span>
		<span class="op2-card__skill">{{skillLabel}} · DT {{dt}}</span>
	</header>
	<p class="op2-card__description">{{text}}</p>
	<div class="op2-card__buttons">
		<button type="button" data-action="op2Survival" data-actor-uuid="{{actorUuid}}" data-kind="{{kind}}">
			{{localize "OP2.Survival.roll"}}
		</button>
	</div>
</div>
