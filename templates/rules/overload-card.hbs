<div class="op2-card op2-card--overload">
	<header class="op2-card__head">
		<span class="op2-card__title">{{localize "OP2.Overload.title"}}</span>
		<span class="op2-card__skill">{{localize "OP2.Overload.round"}} {{round}} · {{formula}}</span>
	</header>
	{{#if anyDamage}}
	<ul class="op2-card__found">
		{{#each lines as |line|}}
		<li>{{line.name}}: <strong>{{line.amount}}</strong> PD</li>
		{{/each}}
	</ul>
	{{else}}
	<p class="op2-card__nothing">{{localize "OP2.Overload.noDamage"}}</p>
	{{/if}}
</div>
